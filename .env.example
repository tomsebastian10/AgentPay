# ==========================================
# AgentPay Environment Configuration
# ==========================================

# Server Port
PORT=3000

# Razorpay Test Mode Credentials
# Get your test keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_key_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# AI Provider / LLM API Key (Optional: system has built-in local deterministic fallback parser)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Mode: 'test' (real Razorpay test mode) or 'mock' (offline test simulation)
PAYMENT_GATEWAY_MODE=mock

# Application Secret for AP2 Spend Authorization Tokens
AUTH_TOKEN_SECRET=dev_spend_authorization_hmac_secret_2026
